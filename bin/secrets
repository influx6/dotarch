#!/usr/bin/env bash
set -euo pipefail

# secrets — drive git-agecrypt transparent encryption with the age key kept in
# 1Password. Day-to-day commands below; one-time bootstrap is in docs/secrets.md.
#
# The age private key lives ONLY in 1Password. `secrets unlock` materialises it
# into a 0600 file outside the repo and points this repo's git-agecrypt identity
# at it; `secrets lock` shreds it again.

OP_VAULT="${SECRETS_OP_VAULT:-Private}"
OP_ITEM="${SECRETS_OP_ITEM:-dotarch-age}"
ID_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/git-agecrypt"
ID_FILE="$ID_DIR/identity"

die()  { echo "secrets: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1 (see installers/every/git-agecrypt.sh)"; }

op_read() { # $1 = field label -> prints value
  need op
  op read "op://$OP_VAULT/$OP_ITEM/$1" 2>/dev/null \
    || die "could not read op://$OP_VAULT/$OP_ITEM/$1 — is 'op' signed in? (op signin)"
}

in_repo() { git rev-parse --git-dir >/dev/null 2>&1; }

cmd_unlock() {
  need git-agecrypt
  mkdir -p "$ID_DIR"; chmod 700 "$ID_DIR"
  ( umask 077; op_read privatekey > "$ID_FILE" )
  chmod 600 "$ID_FILE"
  if in_repo; then
    git-agecrypt config add -i "$ID_FILE"
    echo "unlocked: $ID_FILE (0600); git-agecrypt identity configured for this repo"
  else
    echo "unlocked: $ID_FILE (0600). Run inside a git-agecrypt repo to wire the identity."
  fi
}

cmd_lock() {
  if [ -f "$ID_FILE" ]; then
    if command -v shred >/dev/null 2>&1; then shred -u "$ID_FILE"; else rm -f "$ID_FILE"; fi
    echo "locked: identity removed ($ID_FILE)"
  else
    echo "already locked"
  fi
}

cmd_add() {
  need git-agecrypt
  in_repo || die "not inside a git repository"
  [ "$#" -ge 1 ] || die "usage: secrets add <file> [file...]"
  local pub; pub="$(op_read publickey)"
  for f in "$@"; do
    [ -f "$f" ] || die "no such file: $f"
    git-agecrypt config add -r "$pub" -p "$f"
    echo "registered for encryption: $f"
  done
  echo "reminder: .gitattributes must match these paths, e.g."
  echo "  secrets/** filter=git-agecrypt diff=git-agecrypt"
}

cmd_status() {
  need git-agecrypt
  if in_repo; then git-agecrypt status || true; else echo "(not in a git repo)"; fi
  if [ -f "$ID_FILE" ]; then echo "identity: present ($ID_FILE)"; else echo "identity: absent — run 'secrets unlock'"; fi
}

case "${1:-help}" in
  unlock) shift; cmd_unlock "$@" ;;
  lock)   shift; cmd_lock "$@" ;;
  add)    shift; cmd_add "$@" ;;
  status) shift; cmd_status "$@" ;;
  *)
    cat <<EOF
secrets — git-agecrypt + 1Password helper

  secrets unlock       fetch age key from 1Password -> $ID_FILE (0600) and
                       configure git-agecrypt for the current repo
  secrets lock         shred the local identity file
  secrets add <file>   register file(s) for transparent encryption
  secrets status       show git-agecrypt + identity status

1Password item (override via env):
  SECRETS_OP_VAULT=$OP_VAULT  SECRETS_OP_ITEM=$OP_ITEM
  fields: privatekey, publickey

One-time bootstrap: docs/secrets.md
EOF
    ;;
esac
