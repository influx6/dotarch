#!/bin/bash

# macOS: Homebrew keeps postgresql@16 keg-only, so its server binaries
# (initdb / postgres / pg_ctl) are NOT symlinked onto PATH. The talstack test
# suite's default path (tmp-postgres) needs them, so expose the keg here.
# Check known brew prefixes directly to avoid a `brew --prefix` subprocess on
# every shell start. Install it with: installers/macosx/development/postgresql.sh
for _pg_bin in /opt/homebrew/opt/postgresql@16/bin /usr/local/opt/postgresql@16/bin; do
    if [ -d "$_pg_bin" ]; then
        export PATH="$_pg_bin:$PATH"
        break
    fi
done
unset _pg_bin

if has_command "yay"; then
    if no_command "psql"; then
        yay -Syu timescaledb timescaledb-tune postgresql-libs --noconfirm
    fi
fi

postgres_make(){
    mkdir -p $HOME/local/lib/postgres/server

    if [[ ! -e "$HOME/local/lib/postgres/data/postgresql.conf" ]]; then
        initdb --locale='en_US.UTF-8' --encoding='UTF8' -D $HOME/local/lib/postgres/data --data-checksums
        timescaledb-tune -config-path "$HOME/local/lib/postgres/data/postgresql.conf"
    fi
    if [[ -e "$HOME/.config/systemd/user/postgres.service" ]]; then
        mkdir -p $HOME/.config/systemd/user/
        cp $HOME/dotarch/config/systemd/user/postgres.service $HOME/.config/systemd/user/postgres.service
        # 1. Tell systemd to find the new file
        systemctl --user daemon-reload
        # 2. Enable it to autostart when you log in
        systemctl --user enable postgres.service
        # 3. Start the database engine right now
        systemctl --user start postgres.service
    fi
}

postgres_make_sudo(){
    sudo -u postgres initdb --locale=en_US.UTF-8 --encoding=UTF8 -D /var/lib/postgres/data --data-checksums
    sudo timescaledb-tune 
    sudo systemctl enable postgresql.service
    sudo systemctl start postgresql.service
    sudo -u postgres psql
    \password postgres
}
