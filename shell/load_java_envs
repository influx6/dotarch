#!/bin/sh

# Portable JAVA_HOME from Homebrew's openjdk. brew keeps openjdk keg-only, so its
# binaries aren't on PATH directly; installers/every/langs.sh links them into
# ~/.local/bin (which shell/load_paths keeps ahead of /usr/bin). This just sets
# JAVA_HOME / JDK_HOME and prepends the JDK bin so JVM tooling (gradle, maven,
# jdtls, clojure) can find the JDK without relying on the symlinks.

OPENJDK_PREFIX=""
if command -v brew >/dev/null 2>&1; then
  OPENJDK_PREFIX="$(brew --prefix openjdk 2>/dev/null)" || OPENJDK_PREFIX=""
fi

if [ -n "$OPENJDK_PREFIX" ] && [ -d "$OPENJDK_PREFIX" ]; then
  if [ "$(uname -s)" = "Darwin" ] && [ -d "$OPENJDK_PREFIX/libexec/openjdk.jdk/Contents/Home" ]; then
    export JAVA_HOME="$OPENJDK_PREFIX/libexec/openjdk.jdk/Contents/Home"
  else
    export JAVA_HOME="$OPENJDK_PREFIX"
  fi
  export JDK_HOME="$JAVA_HOME"
  export PATH="$JAVA_HOME/bin:$PATH"
fi
