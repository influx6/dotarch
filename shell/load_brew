#!/bin/sh

test -d ~/.linuxbrew && eval "$(~/.linuxbrew/bin/brew shellenv)"
test -d /home/linuxbrew/.linuxbrew && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

if [[ -d /home/linuxbrew/.linuxbrew ]]; then
	eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
	export XDG_DATA_DIRS="/home/linuxbrew/.linuxbrew/share:$XDG_DATA_DIRS"
	eval "\$($(brew --prefix)/bin/brew shellenv)"
fi

# macOS: make Homebrew dylibs discoverable to tools that dlopen by bare name
# (e.g. WeasyPrint needs pango/glib/gobject). DYLD_FALLBACK_LIBRARY_PATH is only
# consulted when a library isn't found on its normal path, so this is low-risk.
# Idempotent: won't duplicate the entry if this file is sourced more than once.
if [ "$(uname)" = "Darwin" ]; then
	brew_lib="${HOMEBREW_PREFIX:-/opt/homebrew}/lib"
	[ -d "$brew_lib" ] || brew_lib="/usr/local/lib"
	if [ -d "$brew_lib" ]; then
		case ":${DYLD_FALLBACK_LIBRARY_PATH}:" in
			*":$brew_lib:"*) ;;
			*) export DYLD_FALLBACK_LIBRARY_PATH="$brew_lib${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}" ;;
		esac
	fi
	unset brew_lib
fi

# NOTE: package name must come FIRST, extra brew flags after
#       e.g. check_and_install llvm --yes  (NOT check_and_install --yes llvm)
check_and_install() {
	target_package="$1"
	shift

	if ! brew --prefix --installed "$target_package" &>/dev/null; then
		echo "Executing: brew install '$target_package' $*"
		brew install "$target_package" "$@"
	fi
}

check_and_install llvm --yes
check_and_install libpq --yes
check_and_install protobuf --yes
check_and_install snappy --yes
