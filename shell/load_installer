#!/bin/bash

install_files=$Dotfiles/installers


install_one(){
    if is_ubuntu; then
        location="$(find "$install_files/ubuntu" "$install_files/every" -maxdepth 2 -type f -name "$1.sh" -not -path '*/old/*' 2>/dev/null | head -n1)"
    elif is_archlinux; then
        location="$(find "$install_files/archlinux" "$install_files/every" -maxdepth 2 -type f -name "$1.sh" -not -path '*/old/*' 2>/dev/null | head -n1)"
    elif is_mac; then
        location="$(find "$install_files/macosx" "$install_files/every" -maxdepth 2 -type f -name "$1.sh" -not -path '*/old/*' 2>/dev/null | head -n1)"
    else
        echo "Failed to identify operating system"
        return 1
    fi

    if [ -n "$location" ]; then
        echo "Executing script: $(basename "$location") from $location"
        . "$location"
    else
        echo "No installer found for: $1"
        return 1
    fi
}


install_all(){
    if [ -z "$1" ]; then
        echo "Usage: install_all <category>"
        return 1
    fi

    if is_ubuntu; then
        dir="$install_files/ubuntu/$1"
    elif is_archlinux; then
        dir="$install_files/archlinux/$1"
    elif is_mac; then
        dir="$install_files/macosx/$1"
    else
        echo "Failed to identify operating system"
        return 1
    fi

    if [ ! -d "$dir" ]; then
        echo "No installers found for category: $1"
        return 1
    fi

    ran=0
    while IFS= read -r script; do
        ran=1
        echo "Executing script: $(basename "$script")"
        . "$script"
    done < <(find "$dir" -maxdepth 1 -type f -name '*.sh' | sort)

    if [ "$ran" = 0 ]; then
        echo "No installers found in: $dir"
        return 1
    fi
    return 0
}
