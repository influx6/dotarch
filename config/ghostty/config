# Dynamic theme colors
# config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"
# theme = Catppuccin Mocha
# theme = Catppuccin Macchiato, Blazer, Banana Blueberry, Black Metal (Bathory), Bright Lights, Chalkboard, Ciapre, Cutie Pro
# theme = Aura
theme = Catppuccin Mocha


# Font
# font-family = "CaskaydiaMono Nerd Font"
# font-family = "Menlo Bold"
# font-family = "JetBrains Mono"
# font-family = "Osaka-Mono"
font-family = "JetBrainsMono Nerd Font"

font-style = Regular
font-size = 14

# Window
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never

minimum-contrast = 1.1

# Cursor stlying
cursor-style = "block"
cursor-style-blink = false
shell-integration-features = no-cursor

# Keyboard bindings
keybind = f11=toggle_fullscreen


macos-window-shadow = false
# Was 0.95 — the 5% transparency blended the desktop through and read as
# "faded". 1.0 = fully opaque. (background-blur is inert at full opacity.)
background-opacity = 1
# background-blur = 20

# macos config
macos-option-as-alt = true
keybind = alt+left=unbind
keybind = alt+right=unbind

# key bindings
# keybind = all:ctrl+c=copy_to_clipboard

# Use Ghostty splits instead of macOS native tabs: native tabs appear to yabai
# as separate windows (macOS API limitation), which makes it re-tile and resize
# on every tab add/close. Splits live inside one real window, so yabai sees
# nothing new. (cmd+d / cmd+shift+d to split, cmd+w to close the focused split.)
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface

keybind = global:cmd+home=toggle_quick_terminal
keybind = performable:ctrl+c=copy_to_clipboard
keybind = performable:ctrl+v=paste_from_clipboard
keybind = shift+right=adjust_selection:right
keybind = shift+left=adjust_selection:left
keybind = shift+up=adjust_selection:up
keybind = shift+down=adjust_selection:down
keybind = ctrl+shift+c=text:\x03
keybind = ctrl+l=clear_screen
keybind = ctrl+r=reset
keybind = shift+enter=text:\x1b\r
auto-update = off
