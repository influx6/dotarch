// Display/monitor configuration — managed by nwg-displays (monitor.kdl).
// Layout: laptop (eDP-1) on the left, external monitor (DP-1) on the right.

output "eDP-1" {
    mode "1920x1080@144.000"
    scale 1
    position x=0 y=0
}

output "DP-1" {
    mode "2560x1440@59.951"
    scale 1
    position x=1920 y=0
}
